local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ADMIN_NAME = "gust666_falso2"
local CONTROL_NAME = "RemoteEventExplorerControl"

local control = ReplicatedStorage:FindFirstChild(CONTROL_NAME)

if control then
	control:Destroy()
end

control = Instance.new("RemoteEvent")
control.Name = CONTROL_NAME
control.Parent = ReplicatedStorage

local function findRemote(path)
	local current = game

	for part in string.gmatch(path, "[^%.]+") do
		if part ~= "game" then
			current = current:FindFirstChild(part)

			if not current then
				return nil
			end
		end
	end

	return current
end

local function getPath(instance)
	local parts = {}
	local current = instance

	while current and current ~= game do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end

	return "game." .. table.concat(parts, ".")
end

control.OnServerEvent:Connect(function(player, action, remotePath)
	if player.Name ~= ADMIN_NAME then
		return
	end

	if action ~= "Activate" then
		return
	end

	if typeof(remotePath) ~= "string" then
		return
	end

	local remote = findRemote(remotePath)

	if not remote then
		return
	end

	if not remote:IsA("RemoteEvent") then
		return
	end

	local activationEvent = ReplicatedStorage:FindFirstChild("RemoteEventExplorerActivated")

	if not activationEvent then
		activationEvent = Instance.new("BindableEvent")
		activationEvent.Name = "RemoteEventExplorerActivated"
		activationEvent.Parent = ReplicatedStorage
	end

	activationEvent:Fire(player, remote)

	print("[RemoteEvent Explorer] Ativado:", getPath(remote))
end)

Players.PlayerAdded:Connect(function(player)
	if player.Name ~= ADMIN_NAME then
		return
	end

	player.CharacterAdded:Connect(function()
	end)
end)

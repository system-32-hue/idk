local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ADMIN_NAME = "gust666_falso2"
local REMOTE_NAME = "RemoteEventExplorerControl"

local control = ReplicatedStorage:FindFirstChild(REMOTE_NAME)

if not control then
	control = Instance.new("RemoteEvent")
	control.Name = REMOTE_NAME
	control.Parent = ReplicatedStorage
end

local function findByPath(path)
	if typeof(path) ~= "string" then
		return nil
	end

	local current = game

	for part in string.gmatch(path, "[^%.]+") do
		if part ~= "game" then
			current = current:FindFirstChild(part)

			if not current then
				return nil
			end
		end
	end

	return current
end

control.OnServerEvent:Connect(function(player, action, path)
	if player.Name ~= ADMIN_NAME then
		return
	end

	if action ~= "Activate" then
		return
	end

	local remote = findByPath(path)

	if not remote then
		return
	end

	if not remote:IsA("RemoteEvent") then
		return
	end

	print("[RemoteEvent Explorer] Ativado:", path)

	local bindable = ReplicatedStorage:FindFirstChild("RemoteEventExplorerActivated")

	if not bindable then
		bindable = Instance.new("BindableEvent")
		bindable.Name = "RemoteEventExplorerActivated"
		bindable.Parent = ReplicatedStorage
	end

	bindable:Fire(player, remote)
end)
